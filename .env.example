# App
NODE_ENV=development
PORT=4000

# Database option 1 (preferred)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/bussiness-growth

# Database option 2 (use if DATABASE_URL is not set)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=bussiness-growth

# Auth
JWT_SECRET=super_secret_key_here
JWT_EXPIRES_IN=7d

# Protected library assets
LIBRARY_ASSETS_ROOT=/absolute/path/to/bussiness-growth-backend/library_data/assets
LIBRARY_ASSET_TOKEN_SECRET=change_me_to_a_long_random_secret
LIBRARY_ASSET_TOKEN_TTL_SECONDS=900
